{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckyPipewrench/agent-egress-bench/schemas/control-evidence-outcomes.schema.json",
  "title": "Control Evidence v0 outcomes ledger",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "requirement_sha256", "run_id", "rows"],
  "properties": {
    "profile": {"const": "control-evidence-outcomes/v0"}, "requirement_sha256": {"$ref": "#/$defs/sha256"}, "run_id": {"$ref": "#/$defs/id256"},
    "rows": {"type": "array", "minItems": 1, "maxItems": 1000000, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "id256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "caseID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "canaryID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "time": {"type": "string", "format": "date-time", "minLength": 20, "maxLength": 35},
    "row": {"type": "object", "additionalProperties": false, "required": ["case_id", "trial_index", "transport", "expected_verdict", "actual_verdict", "outcome", "adapter_observation", "target_observation", "evidence_sha256", "scoring_facts", "canaries"], "properties": {
      "case_id": {"$ref": "#/$defs/caseID"}, "trial_index": {"type": "integer", "minimum": 1, "maximum": 100}, "transport": {"const": "mcp_stdio"},
      "expected_verdict": {"enum": ["allow", "block", "warn"]}, "actual_verdict": {"enum": ["allow", "block", "warn", "not_applicable", "error"]}, "outcome": {"enum": ["pass", "fail", "not_applicable", "error"]},
      "adapter_observation": {"enum": ["observed", "not_observed", "adapter_unavailable"]}, "target_observation": {"enum": ["observed", "not_observed", "observer_unavailable"]},
      "evidence_sha256": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
      "scoring_facts": {"type": "object", "additionalProperties": false, "required": ["classification", "budget_timing", "structured_evidence"], "properties": {"classification": {"enum": ["correct", "incorrect", "not_applicable", "error"]}, "budget_timing": {"enum": ["within_budget", "over_budget", "not_measured"]}, "structured_evidence": {"enum": ["present", "absent", "not_applicable"]}}},
      "not_applicable_reason": {"type": "string", "minLength": 1, "maxLength": 256}, "error_reason": {"type": "string", "minLength": 1, "maxLength": 256},
      "canaries": {"type": "array", "minItems": 0, "maxItems": 128, "items": {"$ref": "#/$defs/canary"}}
    }, "allOf": [{"if": {"properties": {"outcome": {"const": "not_applicable"}}, "required": ["outcome"]}, "then": {"properties": {"actual_verdict": {"const": "not_applicable"}, "adapter_observation": {"const": "adapter_unavailable"}, "target_observation": {"const": "observer_unavailable"}, "evidence_sha256": {"maxItems": 0}, "canaries": {"maxItems": 0}, "scoring_facts": {"properties": {"classification": {"const": "not_applicable"}, "budget_timing": {"const": "not_measured"}, "structured_evidence": {"const": "not_applicable"}}}}, "required": ["not_applicable_reason"], "not": {"required": ["error_reason"]}}}, {"if": {"properties": {"outcome": {"const": "error"}}, "required": ["outcome"]}, "then": {"properties": {"actual_verdict": {"const": "error"}, "adapter_observation": {"const": "adapter_unavailable"}, "target_observation": {"const": "observer_unavailable"}, "evidence_sha256": {"maxItems": 0}, "canaries": {"maxItems": 0}, "scoring_facts": {"properties": {"classification": {"const": "error"}, "budget_timing": {"const": "not_measured"}, "structured_evidence": {"const": "not_applicable"}}}}, "required": ["error_reason"], "not": {"required": ["not_applicable_reason"]}}}, {"if": {"properties": {"outcome": {"enum": ["pass", "fail"]}}, "required": ["outcome"]}, "then": {"properties": {"actual_verdict": {"not": {"enum": ["not_applicable", "error"]}}, "canaries": {"minItems": 1}}, "not": {"anyOf": [{"required": ["not_applicable_reason"]}, {"required": ["error_reason"]}]}}}]},
    "canary": {"type": "object", "additionalProperties": false, "required": ["canary_id", "polarity", "canary_commitment_sha256", "expected_predicate", "observer_protocol", "observer_version", "target_identity", "state"], "properties": {
      "canary_id": {"$ref": "#/$defs/canaryID"}, "polarity": {"enum": ["positive", "negative"]}, "canary_commitment_sha256": {"$ref": "#/$defs/sha256"}, "expected_predicate": {"enum": ["allow-observed", "block-not-observed"]}, "observer_protocol": {"type": "string", "minLength": 1, "maxLength": 64}, "observer_version": {"type": "string", "minLength": 1, "maxLength": 64}, "target_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "state": {"enum": ["observed", "not_observed", "observer_unavailable"]},
      "window_start": {"$ref": "#/$defs/time"}, "window_end": {"$ref": "#/$defs/time"}, "observer_key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "preceding_health_ref": {"$ref": "#/$defs/sha256"}, "following_health_ref": {"$ref": "#/$defs/sha256"}, "liveness_record_ref": {"$ref": "#/$defs/sha256"}, "observation_ref": {"$ref": "#/$defs/sha256"}
    }, "allOf": [{"if": {"properties": {"polarity": {"const": "positive"}}}, "then": {"properties": {"expected_predicate": {"const": "allow-observed"}, "state": {"const": "observed"}}, "required": ["observation_ref"], "not": {"anyOf": [{"required": ["window_start"]}, {"required": ["window_end"]}, {"required": ["observer_key_id"]}, {"required": ["preceding_health_ref"]}, {"required": ["following_health_ref"]}, {"required": ["liveness_record_ref"]}]}}}, {"if": {"properties": {"polarity": {"const": "negative"}}}, "then": {"properties": {"expected_predicate": {"const": "block-not-observed"}}, "not": {"required": ["observation_ref"]}}}, {"if": {"properties": {"polarity": {"const": "negative"}, "state": {"not": {"const": "observer_unavailable"}}}, "required": ["polarity", "state"]}, "then": {"required": ["window_start", "window_end", "observer_key_id"], "oneOf": [{"required": ["preceding_health_ref", "following_health_ref"], "not": {"required": ["liveness_record_ref"]}}, {"required": ["liveness_record_ref"], "not": {"anyOf": [{"required": ["preceding_health_ref"]}, {"required": ["following_health_ref"]}]}}]}}]}
  },
  "description": "The verifier enforces row/canary completeness and uniqueness, exact requirement membership, canary polarity/state relations, token derivation, observer isolation, negative-window health/liveness continuity, time ordering, and all aggregate/scoring derivations."
}
