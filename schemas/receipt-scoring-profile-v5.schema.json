{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckyPipewrench/agent-egress-bench/schemas/receipt-scoring-profile-v5.schema.json",
  "title": "agent-egress-bench Receipt-Scoring Profile",
  "description": "Per-tool receipt-scoring profile described in docs/RECEIPT-SCORING.md. Records receipt-scoring observations and the provenance necessary to distinguish a declared tool label from the tool's self-report and a legacy corpus digest from exact corpus identity. Profiles are evidence artifacts published by tool maintainers, not certifications.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "tool_version",
    "observed_tool_version",
    "corpus_version",
    "corpus_sha256",
    "benchmark_manifest_sha256",
    "corpus_git_sha",
    "corpus_git_status",
    "tool_profile_sha256",
    "capability_registry",
    "verifier",
    "summary",
    "per_case"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 5, "description": "Schema version. Must be 5 for newly emitted profiles."},
    "tool": {"type": "string", "minLength": 1, "description": "Tool name from the runner tool profile."},
    "tool_version": {"type": "string", "minLength": 1, "description": "Declared compatibility label from the runner tool profile. This is not a measurement of the running binary; compare it with observed_tool_version."},
    "observed_tool_version": {
      "type": "object",
      "description": "Bounded stdout returned by the tool-version command the runner executed, or an explicit status explaining why the runner could not obtain it. The value is not copied from tool_version.",
      "required": ["status", "value"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["observed", "not_requested", "invalid_command", "command_failed", "timed_out", "empty_output", "output_too_large"]},
        "value": {"type": ["string", "null"]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "observed"}}, "required": ["status"]},
        "then": {"properties": {"value": {"type": "string", "minLength": 1}}},
        "else": {"properties": {"value": {"const": null}}}
      }]
    },
    "corpus_version": {"type": "string", "minLength": 1, "description": "Corpus version from the Gauntlet summary."},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Retained legacy SHA-256 over selected case bytes in legacy key order. It detects byte changes but does not bind file boundaries or manifest membership; use benchmark_manifest_sha256 to identify the exact corpus."},
    "benchmark_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 over the exact loaded corpus manifest: family-qualified paths, file boundaries, and bytes. Matches the Gauntlet summary field for the same run."},
    "corpus_git_sha": {"type": "string", "description": "Exact 40-character Git revision only when corpus_git_status is clean. Empty otherwise, so a checkout head cannot be mistaken for dirty or composite corpus bytes."},
    "corpus_git_status": {"enum": ["clean", "dirty", "not_git_checkout", "multiple_sources", "unavailable", "changed_during_capture"], "description": "Whether one clean Git revision identified every source directory while the runner captured the corpus. Any state other than clean requires an empty corpus_git_sha."},
    "tool_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the tool-profile.json used at run time."},
    "capability_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "revision", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "format": {"type": "integer", "minimum": 1},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "verifier": {
      "type": "object",
      "description": "Declarative metadata about the tool's receipt verifier.",
      "required": ["shipped", "open_source", "verifier_url", "license", "exit_code_contract"],
      "additionalProperties": false,
      "properties": {
        "shipped": {"type": "boolean"},
        "open_source": {"type": "boolean"},
        "verifier_url": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "exit_code_contract": {"type": ["string", "null"]}
      }
    },
    "summary": {
      "type": "object",
      "description": "Counts derived from per_case.",
      "required": ["blocked_yes_count", "blocked_no_count", "explained_yes_count", "receipt_produced_yes_count", "receipt_independently_verifiable_yes_count", "false_positive_yes_count"],
      "additionalProperties": false,
      "properties": {
        "blocked_yes_count": {"type": "integer", "minimum": 0},
        "blocked_no_count": {"type": "integer", "minimum": 0},
        "explained_yes_count": {"type": "integer", "minimum": 0},
        "receipt_produced_yes_count": {"type": "integer", "minimum": 0},
        "receipt_independently_verifiable_yes_count": {"type": "integer", "minimum": 0},
        "false_positive_yes_count": {"type": "integer", "minimum": 0}
      }
    },
    "per_case": {
      "type": "array",
      "description": "One row per routed corpus case plus every runner-produced unreachable row. Unreachable and runner-error rows are unmeasured: both blocked and false_positive are n/a and neither affects outcome counts. Historical not-applicable rows are omitted.",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "blocked", "explained", "receipt_produced", "receipt_independently_verifiable", "false_positive"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "blocked": {"enum": ["yes", "no", "n/a"]},
          "explained": {"enum": ["yes", "no"]},
          "receipt_produced": {"enum": ["yes", "no"]},
          "receipt_independently_verifiable": {"enum": ["yes", "partial", "no"]},
          "false_positive": {"enum": ["yes", "no", "n/a"]},
          "receipt_observation_reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "title": "blocked vs false_positive consistency",
            "oneOf": [
              {"properties": {"blocked": {"enum": ["yes", "no"]}, "false_positive": {"const": "n/a"}}},
              {"properties": {"blocked": {"const": "n/a"}, "false_positive": {"enum": ["yes", "no"]}}},
              {"properties": {"blocked": {"const": "n/a"}, "false_positive": {"const": "n/a"}}}
            ]
          },
          {
            "title": "receipt_produced gates verifiability",
            "if": {"properties": {"receipt_produced": {"const": "no"}}, "required": ["receipt_produced"]},
            "then": {"properties": {"receipt_independently_verifiable": {"const": "no"}}}
          },
          {
            "title": "unmeasured rows require an observation reason",
            "if": {
              "properties": {
                "blocked": {"const": "n/a"},
                "false_positive": {"const": "n/a"}
              },
              "required": ["blocked", "false_positive"]
            },
            "then": {"required": ["receipt_observation_reason"]}
          }
        ]
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"corpus_git_status": {"const": "clean"}}, "required": ["corpus_git_status"]},
    "then": {"properties": {"corpus_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "else": {"properties": {"corpus_git_sha": {"const": ""}}}
  }]
}
