{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckyPipewrench/agent-egress-bench/schemas/endpoint-containment-profile-v1.schema.json",
  "title": "Endpoint containment target profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "tool_version", "mode", "expected_user", "probe_path", "target_binary", "version_command", "expected_version_output", "launch_prefix"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "tool": {"type": "string", "minLength": 1},
    "tool_version": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "expected_user": {"type": "string", "minLength": 1},
    "probe_path": {"$ref": "#/$defs/absolute_path"},
    "target_binary": {"$ref": "#/$defs/absolute_path"},
    "version_command": {"$ref": "#/$defs/argv"},
    "expected_version_output": {"type": "string", "minLength": 1},
    "launch_prefix": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [{"$ref": "#/$defs/absolute_path"}],
      "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}
    }
  },
  "$defs": {
    "absolute_path": {"type": "string", "pattern": "^/[^\\u0000]+$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}}
  }
}
