{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckyPipewrench/agent-egress-bench/schemas/control-evidence-requirement.schema.json",
  "title": "Control Evidence v0 requirement payload",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "requirement_id", "challenge_nonce", "issued_at", "not_before", "expires_at", "buyer_id", "deployment_archetype", "enforcement_point", "required_transports", "required_case_ids", "required_positive_canaries", "required_negative_canaries", "approved_observer", "approved_tool_profile", "token_material", "health_control_material", "minimum_trials_per_case", "allowed_not_applicable", "maximum_errors", "maximum_age_seconds", "allowed_future_skew_seconds", "required_artifacts", "trust_policy_id", "trust_policy_sha256", "required_signer_policy", "authorized_run_signers", "approved_runner", "approved_adapter", "approved_tool_identity"],
  "properties": {
    "profile": {"const": "control-evidence-requirement/v0"},
    "requirement_id": {"$ref": "#/$defs/id128"}, "challenge_nonce": {"$ref": "#/$defs/id256"},
    "issued_at": {"$ref": "#/$defs/time"}, "not_before": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"},
    "buyer_id": {"$ref": "#/$defs/opaqueID"},
    "deployment_archetype": {"const": "mcp-stdio-gateway"},
    "enforcement_point": {"type": "object", "additionalProperties": false, "required": ["kind", "note"], "properties": {"kind": {"enum": ["gateway", "proxy", "adapter"]}, "note": {"type": "string", "minLength": 1, "maxLength": 512}}},
    "required_transports": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "mcp_stdio"}},
    "required_case_ids": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/caseID"}},
    "required_positive_canaries": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/canaryID"}},
    "required_negative_canaries": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/canaryID"}},
    "approved_observer": {"type": "object", "additionalProperties": false, "required": ["protocol", "version", "target_identity", "key_id", "maximum_health_control_interval_seconds", "maximum_liveness_gap_seconds"], "properties": {"protocol": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}, "target_identity": {"$ref": "#/$defs/opaqueID"}, "key_id": {"$ref": "#/$defs/keyID"}, "maximum_health_control_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "maximum_liveness_gap_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}},
    "approved_tool_profile": {"type": "object", "additionalProperties": false, "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}}},
    "token_material": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["packaged-encrypted", "buyer-derived"]}, "profile": {"type": "string", "minLength": 1, "maxLength": 128}, "key_or_input_id": {"$ref": "#/$defs/opaqueID"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}, "oneOf": [{"properties": {"mode": {"const": "packaged-encrypted"}}, "required": ["profile", "key_or_input_id", "artifact_sha256"]}, {"properties": {"mode": {"const": "buyer-derived"}}, "required": ["profile", "key_or_input_id"], "not": {"required": ["artifact_sha256"]}}]},
    "health_control_material": {"type": "object", "additionalProperties": false, "required": ["mode", "profile", "key_or_input_id"], "properties": {"mode": {"enum": ["packaged-encrypted", "buyer-derived"]}, "profile": {"type": "string", "minLength": 1, "maxLength": 128}, "key_or_input_id": {"$ref": "#/$defs/opaqueID"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}, "oneOf": [{"properties": {"mode": {"const": "packaged-encrypted"}}, "required": ["artifact_sha256"]}, {"properties": {"mode": {"const": "buyer-derived"}}, "not": {"required": ["artifact_sha256"]}}]},
    "minimum_trials_per_case": {"const": 1},
    "allowed_not_applicable": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "reason"], "properties": {"case_id": {"$ref": "#/$defs/caseID"}, "reason": {"type": "string", "minLength": 1, "maxLength": 256}}}},
    "maximum_errors": {"type": "integer", "minimum": 0, "maximum": 100}, "maximum_age_seconds": {"type": "integer", "minimum": 0, "maximum": 31536000}, "allowed_future_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
    "required_artifacts": {"type": "array", "minItems":1, "maxItems": 32, "uniqueItems": true, "contains":{"const":"tool-profile"}, "items": {"enum": ["tool-profile", "clock-evidence", "observer-evidence", "token-material", "health-control-material", "runner-provenance", "policy", "adapter"]}},
    "trust_policy_id": {"$ref": "#/$defs/opaqueID"}, "trust_policy_sha256": {"$ref": "#/$defs/sha256"},
    "required_signer_policy": {"type": "object", "additionalProperties": false, "required": ["key_id", "authority_id", "role"], "properties": {"key_id": {"$ref": "#/$defs/keyID"}, "authority_id": {"$ref": "#/$defs/opaqueID"}, "role": {"enum": ["vendor-runner", "customer-runner", "independent-witness"]}}},
    "authorized_run_signers": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["key_id", "authority_id", "role"], "properties": {"key_id": {"$ref": "#/$defs/keyID"}, "authority_id": {"$ref": "#/$defs/opaqueID"}, "role": {"enum": ["vendor-runner", "customer-runner", "independent-witness"]}}}},
    "approved_runner": {"$ref": "#/$defs/approvedComponent"}, "approved_adapter": {"$ref": "#/$defs/approvedComponent"},
    "approved_tool_identity": {"type": "object", "additionalProperties": false, "required": ["kind", "expected"], "properties": {"kind": {"enum": ["binary", "image", "saas-deployment", "other"]}, "expected": {"type": "string", "minLength": 1, "maxLength": 512}, "attestation_predicate": {"type": "string", "minLength": 1, "maxLength": 256}}}
    ,"approved_clock_evidence": {"type": "object", "additionalProperties": false, "required": ["key_id", "authority_id", "role", "profile", "verifier_sha256", "policy_sha256", "permitted_skew_seconds"], "properties": {"key_id": {"$ref": "#/$defs/keyID"}, "authority_id": {"$ref": "#/$defs/opaqueID"}, "role": {"enum": ["customer-clock-attestor", "independent-witness-clock-attestor"]}, "profile": {"type": "string", "minLength": 1, "maxLength": 128}, "verifier_sha256": {"$ref": "#/$defs/sha256"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "permitted_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}}}
  },
  "allOf": [{"if": {"properties": {"token_material": {"properties": {"mode": {"const": "packaged-encrypted"}}, "required": ["mode"]}}, "required": ["token_material"]}, "then": {"properties": {"required_artifacts": {"contains": {"const": "token-material"}}}}}, {"if": {"properties": {"health_control_material": {"properties": {"mode": {"const": "packaged-encrypted"}}, "required": ["mode"]}}, "required": ["health_control_material"]}, "then": {"properties": {"required_artifacts": {"contains": {"const": "health-control-material"}}}}}],
  "$defs": {
    "id128": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "id256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "format": "date-time", "minLength": 20, "maxLength": 35}, "opaqueID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "keyID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "caseID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "canaryID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "approvedComponent": {"type": "object", "additionalProperties": false, "required": ["protocol", "version", "sha256"], "properties": {"protocol": {"type": "string", "minLength": 1, "maxLength": 64}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"$ref": "#/$defs/sha256"}, "conformance_artifact_sha256": {"$ref": "#/$defs/sha256"}}}
  },
  "description": "Sorted order, time windows, signer-role separation, component compatibility semantics, and trust-policy validation are verifier-enforced."
}
