{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/luckyPipewrench/agent-egress-bench/main/schemas/control-evidence-token-material-v1.schema.json",
  "title": "Control Evidence v1 decrypted canary token material",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "key_or_input_id", "tokens"],
  "properties": {
    "profile": {"type": "string", "minLength": 1, "maxLength": 128},
    "key_or_input_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "tokens": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["canary_id", "input"], "properties": {"canary_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "input": {"type": "string", "minLength": 1, "maxLength": 4096}}}}
  },
  "description": "The encrypted manifest member decodes to this closed mapping. The verifier enforces canary-ID uniqueness, exact required-ID set equality, UTF-8 input bytes, and equality with the signed material profile and key-or-input ID."
}
