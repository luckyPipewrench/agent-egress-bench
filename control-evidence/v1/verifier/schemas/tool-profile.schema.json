{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckyPipewrench/agent-egress-bench/schemas/tool-profile.schema.json",
  "title": "agent-egress-bench Tool Profile",
  "description": "Active v4 tool profile. Claims are registry-backed reporting labels only. Adapter-proven delivery and observed verdicts determine measurement.",
  "type": "object",
  "required": ["schema_version", "tool", "tool_version", "runner_version", "claims", "capability_registry"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 4},
    "tool": {"type": "string", "minLength": 1},
    "tool_version": {"type": "string", "minLength": 1},
    "runner_version": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Registry-backed reporting labels only. They never determine delivery, applicability, score, sufficiency, publication eligibility, or coverage denominators."
    },
    "capability_registry": {"$ref": "#/$defs/capability_registry"},
    "receipt_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_dir", "file_glob", "detail_json_pointer", "detail_encoding", "verify_command", "valid_exit_codes"],
      "properties": {
        "evidence_dir": {"type": "string", "minLength": 1},
        "file_glob": {"type": "string", "minLength": 1},
        "jsonl_record_type": {"type": "string"},
        "detail_json_pointer": {"type": "string", "pattern": "^(/.*)?$"},
        "detail_encoding": {"enum": ["object", "json_string", "object_or_json_string"]},
        "record_case_id_json_pointer": {"type": "string", "pattern": "^(/.*)?$"},
        "record_identifier_json_pointer": {"type": "string", "pattern": "^(/.*)?$"},
        "case_identifier_json_pointer": {"type": "string", "pattern": "^(/.*)?$"},
        "verify_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "verify_timeout_seconds": {"type": "integer", "minimum": 1},
        "valid_exit_codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "partial_exit_codes": {"type": "array", "items": {"type": "integer"}}
      }
    }
  },
  "$defs": {
    "capability_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "revision", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "format": {"type": "integer", "minimum": 1},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
