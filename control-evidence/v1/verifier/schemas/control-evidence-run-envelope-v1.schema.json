{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckyPipewrench/agent-egress-bench/schemas/control-evidence-run-envelope-v1.schema.json",
  "title": "Control Evidence v1 run-envelope payload",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "capability_registry", "requirement_sha256", "challenge_nonce", "run_id", "started_at", "finished_at", "expires_at", "runner", "corpus", "tool", "policy", "adapter", "scope", "artifacts", "observations", "freshness_basis", "signer"],
  "properties": {
    "profile": {"const": "control-evidence-envelope/v1"}, "capability_registry": {"type":"object","additionalProperties":false,"required":["id","format","revision","sha256"],"properties":{"id":{"$ref":"#/$defs/opaqueID"},"format":{"const":1},"revision":{"type":"integer","minimum":1},"sha256":{"$ref":"#/$defs/sha256"}}}, "requirement_sha256": {"$ref": "#/$defs/sha256"}, "challenge_nonce": {"$ref": "#/$defs/id256"}, "run_id": {"$ref": "#/$defs/id256"},
    "started_at": {"$ref": "#/$defs/time"}, "finished_at": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"},
    "runner": {"type": "object", "additionalProperties": false, "required": ["version", "source_revision", "binary_sha256", "execution_mode"], "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 128}, "source_revision": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}, "binary_sha256": {"$ref": "#/$defs/sha256"}, "execution_mode": {"const": "approved-binary"}, "provenance_sha256": {"$ref": "#/$defs/sha256"}}},
    "corpus": {"type": "object", "additionalProperties": false, "required": ["version", "corpus_sha256", "manifest_sha256", "scoring_version"], "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 128}, "corpus_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "scoring_version": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "tool": {"type": "object", "additionalProperties": false, "required": ["product", "version", "identity"], "properties": {"product": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "identity": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["binary", "image", "saas-deployment", "other"]}, "value": {"type": "string", "minLength": 1, "maxLength": 512}}}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "descriptor": {"type": "string", "maxLength": 512}}},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["protocol", "version", "sha256", "owner"], "properties": {"protocol": {"type": "string", "minLength": 1, "maxLength": 64}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"$ref": "#/$defs/sha256"}, "owner": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["deployment_archetype", "transports", "case_ids_sha256", "enforcement_point"], "properties": {"deployment_archetype": {"const": "mcp-stdio-gateway"}, "transports": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "mcp_stdio"}}, "case_ids_sha256": {"$ref": "#/$defs/sha256"}, "enforcement_point": {"enum": ["gateway", "proxy", "adapter"]}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["manifest_sha256", "count"], "properties": {"manifest_sha256": {"$ref": "#/$defs/sha256"}, "count": {"type": "integer", "minimum": 5, "maximum": 256}}},
    "observations": {"type": "object", "additionalProperties": false, "required": ["sha256", "row_count", "observer_protocol", "observer_version"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "row_count": {"type": "integer", "minimum": 1, "maximum": 1000000}, "observer_protocol": {"type": "string", "minLength": 1, "maxLength": 64}, "observer_version": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "freshness_basis": {"enum": ["vendor-asserted-clock", "customer-observed-clock", "independent-witness-clock"]}, "clock_evidence_ref": {"$ref": "#/$defs/sha256"},
    "result_claim": {"enum": ["valid", "invalid", "stale", "scope-mismatch", "insufficient-evidence", "unverifiable"]},
    "signer": {"type": "object", "additionalProperties": false, "required": ["key_id", "authority_id", "role"], "properties": {"key_id": {"$ref": "#/$defs/opaqueID"}, "authority_id": {"$ref": "#/$defs/opaqueID"}, "role": {"enum": ["vendor-runner", "customer-runner", "independent-witness"]}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "id256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "pattern": "Z$", "minLength": 20, "maxLength": 35}, "opaqueID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
  "description": "Conditional clock-evidence requirements, time ordering, exact requirement membership, approved identities, and signature/trust checks are verifier-enforced."
}
