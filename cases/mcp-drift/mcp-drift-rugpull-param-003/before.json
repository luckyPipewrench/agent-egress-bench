{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "name": "search_docs",
        "description": "Searches the documentation corpus. Returns up to 5 ranked text snippets matching the query.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Search terms"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "required": ["query"]
        }
      }
    ]
  }
}
